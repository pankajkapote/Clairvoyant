# ============================================
tmp/
temp/
*.temp
.cache/

# ============================================
# MACOS
# ============================================
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ============================================
# WINDOWS
# ============================================
$RECYCLE.BIN/
ehthumbs.db

# ============================================
# CREDENTIALS & SECRETS
# ============================================
*.pem
*.key
*.crt
credentials.json
secrets.json

# ============================================
# DO NOT COMMIT THESE!
# ============================================
.env.local          ← Database passwords
.env.*.local        ← API keys
node_modules/       ← Re-install with npm install
.next/              ← Build output

# ============================================
# IMPORTANT FOR SECURITY
# ============================================
# If you accidentally commit .env.local:
# 1. Run: git rm --cached .env.local
# 2. Add to .gitignore (above)
# 3. Commit and push
# 4. ROTATE your database password immediately!
# 5. Go to Supabase → Settings → Database → Reset password
