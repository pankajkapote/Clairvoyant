# ============================================
# CLAIRVOYANT SAAS - ENVIRONMENT VARIABLES
# ============================================
# 
# INSTRUCTIONS:
# 1. Rename this file to .env.local
# 2. Fill in YOUR values (get from Supabase)
# 3. Never commit .env.local to Git
# 4. Add .env.local to .gitignore
#
# ============================================

# ============================================
# DATABASE CONNECTION (Supabase)
# ============================================
# For DEVELOPMENT (local testing):
# Use direct connection from Supabase
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST.supabase.co:5432/postgres

# For PRODUCTION (Vercel):
# Use pooler connection from Supabase
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST.pooler.supabase.com:6543/postgres

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.supabase.co:5432/postgres

# Database type
DB_TYPE=postgresql

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_NAME=Clairvoyant
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata

# ============================================
# AUTHENTICATION
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars-here

# Local development URL
NEXTAUTH_URL=http://localhost:3000

# For production, change to your domain:
# NEXTAUTH_URL=https://yourdomain.com

# ============================================
# EMAIL SERVICE (SendGrid - Optional)
# ============================================
# Get API key from: https://app.sendgrid.com/settings/api_keys
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=SG-xxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@clairvoyant.io

# ============================================
# PAYMENT GATEWAY (Razorpay - Optional)
# ============================================
# Get from: https://dashboard.razorpay.com/
# RAZORPAY_KEY_ID=rzp_xxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=rzp_xxxxxxxxxxxxx

# ============================================
# STORAGE (AWS S3 - Optional)
# ============================================
# AWS_S3_BUCKET=clairvoyant-bucket
# AWS_S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=xxxxx
# AWS_SECRET_ACCESS_KEY=xxxxx

# ============================================
# SUPABASE SPECIFIC (For direct API access)
# ============================================
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================
# LOGGING
# ============================================
# LOG_LEVEL=info
# DEBUG=false

# ============================================
# Feature Flags
# ============================================
# ENABLE_EMAIL_NOTIFICATIONS=false
# ENABLE_PAYMENT_GATEWAY=false
# ENABLE_ADVANCED_ANALYTICS=false
